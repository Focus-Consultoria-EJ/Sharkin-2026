{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "outDir": "./dist",

    "paths": {
      "@lib/*": ["./lib/*"],
      "@repository/*": ["./src/repository/*"]
    },

    "incremental": true
  }
}
