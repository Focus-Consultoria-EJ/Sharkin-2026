generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  user_id  String   @id
  name     String
  email    String   @unique
  password String
  duties   Duties[]

  @@map("users")
}

model Duties {
  duty_id  String   @id
  user_id  String
  user     Users    @relation(fields: [user_id], references: [user_id])
  date     DateTime
  in_time  DateTime
  out_time DateTime

  @@map("duties")
}
